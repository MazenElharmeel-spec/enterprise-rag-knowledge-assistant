FROM python:3.12-slim AS build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY backend ./backend
COPY data ./data
RUN uv sync --frozen --no-dev

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/backend /app/backend
COPY --from=build /app/data /app/data
COPY --from=build /app/pyproject.toml /app/pyproject.toml
COPY --from=build /bin/uv /bin/uv
COPY --from=build /bin/uvx /bin/uvx
COPY alembic.ini ./
RUN useradd --create-home --uid 10001 appuser && mkdir -p /data/uploads \
    && chown -R appuser:appuser /app /data/uploads
USER appuser
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]

